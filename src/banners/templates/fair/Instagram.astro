---
// Fair (e.g. ग्राहक पेठ) — 1080×1350 (4:5) Instagram feed post. Same blocks as Whatsapp.astro, compact sizes;
// the intro and closing paragraphs are left out (they belong in the post caption).
import type { Banner } from '@/banners/resolve';
import type { BannerFormat } from '@/banners/formats';
import { decorUrl } from '@/banners/assets';
import Frame from '@/banners/blocks/Frame.astro';
import HeaderLogos from '@/banners/blocks/HeaderLogos.astro';
import Organisers from '@/banners/blocks/Organisers.astro';
import TitleBlock from '@/banners/blocks/TitleBlock.astro';
import WhenWhere from '@/banners/blocks/WhenWhere.astro';
import ItemsList from '@/banners/blocks/ItemsList.astro';
import FooterLine from '@/banners/blocks/FooterLine.astro';
import DecorRow from '@/banners/blocks/DecorRow.astro';

interface Props {
  banner: Banner;
  format: BannerFormat;
}
const { banner: b, format } = Astro.props;
const { decor } = b.theme;
---
<Frame format={format} pattern={decor.pattern} compact>
  {decor.top && <img src={decorUrl(decor.top)} alt="" class="w-full" />}

  <HeaderLogos left={b.logos.left} right={b.logos.right} invite={b.invite} tagline={b.tagline} compact />
  <Organisers names={b.organisers} suffix={b.organisersSuffix} compact />
  <TitleBlock top={b.title.top} main={b.title.main} yearMr={b.yearMr} decor={decor} compact />
  <WhenWhere days={b.days} venue={b.venue} compact />
  {b.items.length > 0 && <ItemsList heading={b.itemsHeading} items={b.items} more={b.itemsMore} compact />}
  {b.footer && <FooterLine text={b.footer} compact />}
  {decor.bottomRow && <DecorRow file={decor.bottomRow} compact />}
</Frame>
