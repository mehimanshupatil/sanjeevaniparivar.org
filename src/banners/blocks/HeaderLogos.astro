---
// Top row: left logo · invitation line + tagline · right logo
import type { BannerLogo } from '../logos';

interface Props {
  left?: BannerLogo;
  right?: BannerLogo;
  invite: string;
  tagline?: string;
  /** Smaller sizes for shorter formats (e.g. Instagram post) */
  compact?: boolean;
}
const { left, right, invite, tagline, compact = false } = Astro.props;
const logoSize = (l: BannerLogo) =>
  l.shape === 'seal' ? (compact ? 'size-[104px]' : 'size-[128px]') : (compact ? 'size-24' : 'size-[120px]');
const figure = compact ? 'w-[150px] gap-1' : 'w-[170px] gap-1.5';
const caption = compact ? 'text-[15px]' : 'text-[17px]';
---
<header class="w-full flex items-center justify-between gap-6 -mt-2">
  {[left, null, right].map((logo, i) =>
    i === 1 ? (
      <div class:list={['flex-1 flex flex-col items-center text-center', compact ? 'gap-2' : 'gap-2.5']}>
        <p class:list={['font-ornate tracking-[1px] text-primary', compact ? 'text-[30px]' : 'text-[34px]']}>{invite}</p>
        {tagline && <p class:list={['font-medium text-ink-soft', compact ? 'text-[20px]' : 'text-[23px]']}>{tagline}</p>}
      </div>
    ) : logo && (
      <figure class:list={[figure, 'flex flex-col items-center text-center']}>
        <img src={logo.src} alt={logo.caption} class:list={[logoSize(logo), 'object-contain']} />
        <figcaption class:list={[caption, 'font-semibold leading-[1.25] text-deep']}>{logo.caption}</figcaption>
      </figure>
    ),
  )}
</header>
