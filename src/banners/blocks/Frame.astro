---
// Paper background + pattern + double border. Content is spread top-to-bottom inside.
// #banner is what gets screenshotted; #content is checked for overflow.
import type { BannerFormat } from '../formats';
import { decorUrl } from '../assets';

interface Props {
  format: BannerFormat;
  pattern?: string;
  compact?: boolean;
}
const { format, pattern, compact = false } = Astro.props;
---
<main
  id="banner"
  class:list={['overflow-hidden bg-ground bg-[length:96px_96px] font-body text-ink', compact ? 'p-[18px]' : 'p-[22px]']}
  style={{
    width: `${format.width}px`,
    height: `${format.height}px`,
    backgroundImage: pattern ? `url("${decorUrl(pattern)}")` : undefined,
  }}
>
  <div class="h-full border-[3px] border-deep p-1.5">
    <div id="content" class:list={['relative h-full flex flex-col items-center justify-between border border-gold', compact ? 'px-8 pb-5' : 'px-[38px] pb-[26px]']}>
      <slot />
    </div>
  </div>
</main>
