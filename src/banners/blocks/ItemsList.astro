---
// Two-column list with marigold bullets, e.g. a fair's attractions
interface Props {
  heading?: string;
  items: string[];
  more?: string;
  compact?: boolean;
}
const { heading, items, more, compact = false } = Astro.props;
const s = compact
  ? { gap: 'gap-3', heading: 'text-[28px]', list: 'gap-y-2 text-[21px]', more: 'text-[21px]' }
  : { gap: 'gap-[18px]', heading: 'text-[34px]', list: 'gap-y-3 text-[24px]', more: 'text-[24px]' };
---
<section class:list={[s.gap, 'w-full flex flex-col items-center']}>
  {heading && <h2 class:list={[s.heading, 'font-ornate font-normal text-primary']}>{heading}</h2>}
  <ul class:list={[s.list, 'w-full grid grid-cols-2 gap-x-10 px-[30px] font-medium']}>
    {items.map((item) => (
      <li class="flex items-center gap-3.5 before:size-4 before:flex-none before:rounded-full before:border-2 before:border-marigold-edge before:bg-marigold before:content-['']">
        {item}
      </li>
    ))}
  </ul>
  {more && <p class:list={[s.more, 'font-bold text-deep']}>{more}</p>}
</section>
