---
// Two-column list with marigold bullets, e.g. a fair's attractions
interface Props {
  heading?: string;
  items: string[];
  more?: string;
}
const { heading, items, more } = Astro.props;
---
<section class="w-full flex flex-col items-center gap-[18px]">
  {heading && <h2 class="font-ornate text-[34px] font-normal text-primary">{heading}</h2>}
  <ul class="w-full grid grid-cols-2 gap-x-10 gap-y-3 px-[30px] text-[24px] font-medium">
    {items.map((item) => (
      <li class="flex items-center gap-3.5 before:size-4 before:flex-none before:rounded-full before:border-2 before:border-marigold-edge before:bg-marigold before:content-['']">
        {item}
      </li>
    ))}
  </ul>
  {more && <p class="text-[24px] font-bold text-deep">{more}</p>}
</section>
