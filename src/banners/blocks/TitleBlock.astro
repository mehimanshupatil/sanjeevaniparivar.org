---
// Title with optional ornament behind (titleBack) and either side (titleSides), then the year
import type { ThemeDecor } from '../themes';
import { decorUrl } from '../assets';

interface Props {
  top?: string;
  main: string;
  yearMr: string;
  decor: ThemeDecor;
  compact?: boolean;
}
const { top, main, yearMr, decor, compact = false } = Astro.props;
const s = compact
  ? { back: 'size-[520px]', side: '-top-6 w-[90px] h-[228px]', top: 'text-[60px]', main: 'text-[124px]', year: 'text-[48px]', rule: 'w-[120px]' }
  : { back: 'size-[640px]', side: '-top-[34px] w-[110px] h-[280px]', top: 'text-[76px]', main: 'text-[156px]', year: 'text-[60px]', rule: 'w-[150px]' };
---
<section class="relative z-0 w-full flex flex-col items-center text-center">
  {decor.titleBack && (
    <img src={decorUrl(decor.titleBack)} alt=""
      class:list={[s.back, 'absolute -z-1 left-1/2 top-1/2 max-w-none -translate-x-1/2 -translate-y-1/2 opacity-[0.11]']} />
  )}
  {decor.titleSides && <>
    <img src={decorUrl(decor.titleSides)} alt="" class:list={[s.side, 'absolute -left-[6px]']} />
    <img src={decorUrl(decor.titleSides)} alt="" class:list={[s.side, 'absolute -right-[6px]']} />
  </>}
  <h1 class="flex flex-col items-center font-normal">
    {top && <span class:list={[s.top, 'font-display leading-[1.1] text-deep']}>{top}</span>}
    <span class:list={[s.main, 'mt-1 font-display leading-[1.05] text-primary']}>{main}</span>
  </h1>
  <div class="mt-1.5 flex items-center gap-[22px]">
    <i class:list={[s.rule, 'h-0.5 bg-gold']}></i>
    <i class="size-2.5 rotate-45 bg-gold"></i>
    <span class:list={[s.year, 'font-ornate leading-none text-gold']}>{yearMr}</span>
    <i class="size-2.5 rotate-45 bg-gold"></i>
    <i class:list={[s.rule, 'h-0.5 bg-gold']}></i>
  </div>
</section>
