---
// Date & venue band: दिनांक (one block per day) | स्थळ
interface Props {
  days: { date: string; time: string }[];
  venue: string[];
}
const { days, venue } = Astro.props;
const heading = 'flex items-center gap-3 mb-3.5 font-ornate text-[30px] font-normal text-band-accent';
const icon = 'size-[30px] fill-none stroke-band-accent stroke-[1.8]';
---
<section class="w-full grid grid-cols-2 gap-8 rounded-[6px] bg-deep px-9 py-[30px] text-band-text">
  <div>
    <h2 class={heading}>
      <svg viewBox="0 0 24 24" aria-hidden="true" class={icon} stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />
      </svg>दिनांक
    </h2>
    {days.map((d, i) => <>
      {i > 0 && <hr class="my-3.5 h-px border-0 bg-band-accent/45" />}
      <p class="text-[26px] font-bold">{d.date}</p>
      <p class="text-[22px] text-band-soft">{d.time}</p>
    </>)}
  </div>
  <div class="border-l border-band-accent/45 pl-8">
    <h2 class={heading}>
      <svg viewBox="0 0 24 24" aria-hidden="true" class={icon} stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
      </svg>स्थळ
    </h2>
    <p class="font-display text-[44px] leading-[1.2]">
      {venue.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </p>
  </div>
</section>
