---
// A row of one ornament (e.g. diyas) with marigold dots between
import { decorUrl } from '../assets';

interface Props {
  file: string;
  count?: number;
  compact?: boolean;
}
const { file, count = 7, compact = false } = Astro.props;
const img = compact ? 'w-16 h-14' : 'w-[84px] h-[74px]';
const dot = compact ? 'mb-1 size-3 border-2' : 'mb-1.5 size-[14px] border-[3px]';
---
<div class="w-full flex items-end justify-between px-2.5" aria-hidden="true">
  {Array.from({ length: count }, (_, i) => <>
    {i > 0 && <i class:list={[dot, 'flex-none rounded-full border-marigold-edge bg-marigold']}></i>}
    <img src={decorUrl(file)} alt="" class={img} />
  </>)}
</div>
