---
import { yearsOfService } from "@/lib/org";
/**
 * index.astro — Landing page
 *
 * Static generation (output: 'static' in astro.config.mjs).
 * The React <App /> island is hydrated client-side (client:load)
 * so language switching works without a server.
 *
 * For future pages: duplicate this file, add a new Astro page
 * and import the relevant React section components.
 */
import Layout from "@/layouts/Layout.astro";
import App from "@/components/App";
import { editionEvents } from "@/publicity/events";

// Not over yet at build time, soonest first; the browser re-checks (UpcomingEvent.tsx)
const today = new Date().toISOString().slice(0, 10);
const upcoming = (await editionEvents())
  .filter((e) => (e.endDate ?? e.date) >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
---

<Layout
  title="संजीवनी परिवार | Sanjeevani Parivar — ध्यास परिवर्तनाचा"
  description={`Sanjeevani Parivar is a leading social organization from Vasai working in Education, Environment, Health & Enlightenment for ${yearsOfService}+ years.`}
  ogImage="/og/home.png"
>
  <App client:load upcoming={upcoming} />
</Layout>
