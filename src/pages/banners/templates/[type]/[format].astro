---
// /banners/templates/fair/whatsapp/ — a template filled with its sample content.
// Shown (scaled) in the template gallery and the try-out editor, which sends drafts
// in via postMessage. Also rendered by render-banners.mjs, so CI fails if a template
// change makes its sample overflow.
import BannerLayout from '@/banners/BannerLayout.astro';
import LiveBanner from '@/banners/LiveBanner';
import { TEMPLATES, type ProgrammeType } from '@/banners/templates';
import { FORMATS, type FormatId } from '@/banners/formats';
import { THEMES } from '@/banners/themes';

export function getStaticPaths() {
  return Object.entries(TEMPLATES).flatMap(([type, t]) =>
    Object.keys(t.layouts).map((format) => ({ params: { type, format } })),
  );
}

const type = Astro.params.type as ProgrammeType;
const format = Astro.params.format as FormatId;
const { sample, label } = TEMPLATES[type];
---
<BannerLayout title={`${label} — ${FORMATS[format].label} (नमुना)`} colors={THEMES[sample.programme.data.theme].colors}>
  <LiveBanner client:load type={type} format={format} programme={sample.programme} edition={sample.edition} />
</BannerLayout>
