---
// /publicity/templates/fair/whatsapp/ — a template filled with its sample content.
// Shown (scaled) in the template gallery and the try-out editor, which sends drafts
// in via postMessage. Also rendered by render-publicity.mjs, so CI fails if a template
// change makes its sample overflow.
import PublicityLayout from '@/publicity/PublicityLayout.astro';
import LivePublicity from '@/publicity/LivePublicity';
import { TEMPLATES, type ProgrammeType } from '@/publicity/templates';
import { FORMATS, type FormatId } from '@/publicity/formats';
import { THEMES } from '@/publicity/themes';

export function getStaticPaths() {
  return Object.entries(TEMPLATES).flatMap(([type, t]) =>
    Object.keys(t.layouts).map((format) => ({ params: { type, format } })),
  );
}

const type = Astro.params.type as ProgrammeType;
const format = Astro.params.format as FormatId;
const { sample, label } = TEMPLATES[type];
---
<PublicityLayout title={`${label} — ${FORMATS[format].label} (नमुना)`} theme={THEMES[sample.programme.data.theme]}>
  <LivePublicity client:load type={type} format={format} programme={sample.programme} edition={sample.edition} />
</PublicityLayout>
