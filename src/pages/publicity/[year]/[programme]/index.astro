---
// /publicity/2026/grahak-peth/ — every format's rendered PNG/PDF for one edition, to preview and download.
// Images are written by scripts/render-publicity.mjs after `astro build`; in `pnpm dev` the
// live Publicity page is shown instead.
import PublicityPreviewLayout from '@/layouts/PublicityPreviewLayout.astro';
import { cardEditions, FORMATS, type ResolvedEdition } from '@/publicity/resolve';
import { TEMPLATES, type Template } from '@/publicity/templates';
import { STYLES, type StyleId } from '@/publicity/styles';

export async function getStaticPaths() {
  const editions = await cardEditions();
  return editions.map((edition) => {
    const [year, programme] = edition.id.split('/');
    return { params: { year, programme }, props: { edition } };
  });
}

interface Props {
  edition: ResolvedEdition;
}
const { edition: b } = Astro.props;
const base = `/publicity/${b.id}`;
/** Saved file name, e.g. grahak-peth-2026-whatsapp.png — says what it is once downloaded. */
const fileName = (format: string, suffix: string) => `${b.programme}-${b.year}-${format}${suffix}`;
const outputsAt = (dir: string, namePart: string) => b.formats.map((id) => {
  const f = FORMATS[id];
  const name = namePart ? `${namePart}-${id}` : id;
  return {
    id,
    label: f.label,
    size: `${f.width} × ${f.height}`,
    width: f.width,
    height: f.height,
    page: `${dir}/${id}/`,
    files: [
      { href: `${dir}/${id}.png`, name: fileName(name, '.png'), label: 'PNG', note: 'WhatsApp / सोशल मीडिया' },
      { href: `${dir}/${id}@2x.png`, name: fileName(name, '-hd.png'), label: 'PNG HD', note: `छपाई (${f.width * 2} × ${f.height * 2})` },
      { href: `${dir}/${id}.pdf`, name: fileName(name, '.pdf'), label: 'PDF', note: 'छपाई' },
    ],
  };
});
// The edition's own cards (its type's Template), each style, then (lectures) one group per session (पुष्प)
const groups = [
  { heading: 'पारंपरिक रचना', outputs: outputsAt(base, '') },
  // Every edition is also rendered in each style; members pick which to share.
  ...(Object.keys(STYLES) as StyleId[]).map((id) => ({
    heading: `${STYLES[id].label} — ${STYLES[id].description}`,
    outputs: outputsAt(`${base}/${id}`, id),
  })),
  ...(TEMPLATES[b.type] as Template).sessionLayouts
    ? b.sessions.map((x) => ({ heading: `${x.label} — ${x.speaker.name}`, outputs: outputsAt(`${base}/${x.n}`, `pushpa-${x.n}`) }))
    : [],
];

// Personal invitation: the card is an iframe of /vaiyaktik/whatsapp/, with the name the member types
const personal = b.personal && {
  page: `${base}/vaiyaktik/whatsapp/`,
  fileName: `${b.programme}-${b.year}-nimantran`,
};
---
<PublicityPreviewLayout title={b.fullTitle}>
  <Fragment slot="crumbs">
    <span class="text-gray-300">/</span>
    <span class="text-gray-500">{b.fullTitle}</span>
  </Fragment>

  <h1 class="text-3xl font-extrabold text-gray-900">{b.fullTitle}</h1>
  <div class="mt-3 flex flex-col gap-1 text-gray-600">
    {b.days.map((d) => <p><span class="font-semibold text-gray-800">{d.date}</span> · {d.time}</p>)}
    <p>{b.venue.join(' ')}</p>
  </div>

  {personal && (
    <section class="mt-12 rounded-2xl bg-white border border-gray-100 p-4 sm:p-6" data-personal data-page={personal.page} data-file-name={personal.fileName}>
      <h2 class="text-xl font-bold text-gray-900">वैयक्तिक निमंत्रण</h2>
      <p class="mt-1 text-sm text-gray-600">पाहुण्याचे नाव लिहा आणि निमंत्रण डाउनलोड करा. नाव कुठेही साठवले जात नाही.</p>
      <div class="mt-6 grid gap-8 md:grid-cols-[minmax(0,360px)_1fr]">
        <div class="rounded-lg overflow-hidden border border-gray-100 bg-gray-100" style="aspect-ratio: 1080 / 1920" data-personal-preview>
          <iframe src={personal.page} title="वैयक्तिक निमंत्रण" class="border-0 pointer-events-none origin-top-left" style="width: 1080px; height: 1920px"></iframe>
        </div>
        <div class="flex flex-col gap-4">
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-gray-800">पाहुण्याचे नाव, गाव</span>
            <input type="text" data-personal-name placeholder="उदा. श्री. नाव आडनाव, गाव" autocomplete="off"
              class="rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-primary focus:outline-none" />
          </label>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-personal-download class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">PNG डाउनलोड</button>
            <button type="button" data-personal-share hidden class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-semibold hover:border-primary hover:text-primary disabled:opacity-50">शेअर करा</button>
          </div>
        </div>
      </div>
    </section>
  )}

  {groups.map((g) => (<>
  {g.heading && <h2 class="mt-12 text-xl font-bold text-gray-900">{g.heading}</h2>}
  <div class="mt-6 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
    {g.outputs.map((o) => (
      <section class="rounded-2xl bg-white border border-gray-100 p-4 flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="font-bold text-gray-900">{o.label}</h2>
          <span class="text-xs font-mono text-gray-400">{o.size}</span>
        </div>

        <a href={o.files[0].href} target="_blank" class="block rounded-lg overflow-hidden border border-gray-100 bg-gray-100"
           style={`aspect-ratio: ${o.width} / ${o.height}`} data-preview data-page={o.page} data-width={o.width}>
          <img src={o.files[0].href} alt={`${b.fullTitle} — ${o.label}`} loading="lazy" class="w-full h-full object-contain" />
        </a>
        <p class="hidden text-xs text-gray-500" data-missing>
          अजून रेंडर झालेले नाही — <code>pnpm build && pnpm publicity</code> चालवा. खाली थेट पान:
        </p>

        <div class="flex flex-wrap gap-2">
          {o.files.map((f) => (
            <a href={f.href} download={f.name} data-file class="inline-flex flex-col rounded-lg border border-gray-200 px-3 py-2 hover:border-primary hover:text-primary">
              <span class="text-sm font-semibold">{f.label}</span>
              <span class="text-xs text-gray-500">{f.note}</span>
            </a>
          ))}
        </div>
        <a href={o.page} class="text-sm text-primary font-semibold hover:underline">थेट पान पहा →</a>
      </section>
    ))}
  </div>
  </>))}
</PublicityPreviewLayout>

<script>
  import type { PersonalMessage, PersonalReply } from '@/publicity/personal/client';

  // Personal invitation: the name goes into the card iframe; the card page makes the PNG (it has the card's fonts and styles) and posts it back.
  const personal = document.querySelector<HTMLElement>('[data-personal]');
  if (personal) {
    const preview = personal.querySelector<HTMLElement>('[data-personal-preview]')!;
    const frame = preview.querySelector('iframe')!;
    const input = personal.querySelector<HTMLInputElement>('[data-personal-name]')!;
    const download = personal.querySelector<HTMLButtonElement>('[data-personal-download]')!;
    const share = personal.querySelector<HTMLButtonElement>('[data-personal-share]')!;
    const post = (m: PersonalMessage) => frame.contentWindow!.postMessage(m, location.origin);

    const scale = () => { frame.style.transform = `scale(${preview.clientWidth / 1080})`; };
    scale();
    new ResizeObserver(scale).observe(preview);

    const name = () => input.value.trim();
    let timer: number | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => post({ kind: 'personal-guest', name: name() }), 250);
    });
    // A name typed before the card page loaded
    frame.addEventListener('load', () => { if (name()) post({ kind: 'personal-guest', name: name() }); });

    /** Asks the card page for the PNG of the card as it is now. */
    const png = () => new Promise<File>((resolve) => {
      const onReply = (e: MessageEvent<PersonalReply>) => {
        if (e.source !== frame.contentWindow || e.data?.kind !== 'personal-png') return;
        window.removeEventListener('message', onReply);
        const who = name().replace(/[\\/:*?"<>|,]/g, '').replace(/\s+/g, '-');
        resolve(new File([e.data.blob], `${personal.dataset.fileName}${who ? `-${who}` : ''}.png`, { type: 'image/png' }));
      };
      window.addEventListener('message', onReply);
      // Send the latest name first, in case the debounce hasn't fired yet
      clearTimeout(timer);
      post({ kind: 'personal-guest', name: name() });
      post({ kind: 'personal-export' });
    });
    const busy = async (button: HTMLButtonElement, work: () => Promise<void>) => {
      button.disabled = true;
      try { await work(); } finally { button.disabled = false; }
    };

    download.addEventListener('click', () => busy(download, async () => {
      const file = await png();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(file);
      a.download = file.name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }));

    // Phones: share the image straight to WhatsApp (Web Share API with files)
    const probe = new File([''], 'x.png', { type: 'image/png' });
    if (navigator.canShare?.({ files: [probe] })) {
      share.hidden = false;
      share.addEventListener('click', () => busy(share, async () => {
        const file = await png();
        await navigator.share({ files: [file] }).catch(() => {});
      }));
    }
  }

  // In `pnpm dev` the PNGs don't exist yet: swap in the live Publicity page, scaled down.
  document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
    const img = link.querySelector('img')!;
    const showLive = () => {
      const missing = link.parentElement!.querySelector('[data-missing]')!;
      missing.classList.remove('hidden');
      const frame = document.createElement('iframe');
      frame.src = link.dataset.page!;
      frame.title = 'live preview';
      const width = Number(link.dataset.width);
      const scale = link.clientWidth / width;
      Object.assign(frame.style, { border: '0', pointerEvents: 'none', transformOrigin: '0 0', width: `${width}px`, height: `${link.clientHeight / scale}px`, transform: `scale(${scale})` });
      link.replaceChildren(frame);
      link.href = link.dataset.page!; // the PNG doesn't exist, so open the live page instead
    };
    if (img.complete && img.naturalWidth === 0) showLive();
    else img.addEventListener('error', showLive);
  });

  // A missing file answers with an HTML 404 page, which `download` would save as the file.
  // Disable those buttons instead.
  document.querySelectorAll<HTMLAnchorElement>('[data-file]').forEach(async (a) => {
    const res = await fetch(a.href, { method: 'HEAD' }).catch(() => null);
    const isHtml = res?.headers.get('content-type')?.includes('text/html');
    if (res?.ok && !isHtml) return;
    a.removeAttribute('href');
    a.removeAttribute('download');
    a.setAttribute('aria-disabled', 'true');
    a.title = 'अजून रेंडर झालेले नाही';
    Object.assign(a.style, { opacity: '0.4', cursor: 'not-allowed' });
  });
</script>
